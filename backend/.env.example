# MassCommAI Backend Configuration Example
# Copy to backend/.env and update values for your environment

PROJECT_NAME="MassCommAI"
VERSION="1.0.0"
APP_ENV="development"
DEBUG=true

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/masscommai_dev"

# Authentication & Security (generate a 32+ byte random string)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

