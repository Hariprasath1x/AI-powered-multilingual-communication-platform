# MassCommAI Backend Configuration Example
# Copy to backend/.env and update values for your environment

PROJECT_NAME="MassCommAI"
VERSION="1.0.0"
APP_ENV="development"
DEBUG=true

# Database Configuration (PostgreSQL)
# Format: postgresql+psycopg://<user>:<password>@<host>:<port>/<dbname>
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/masscommai_dev"

# Redis & Distributed Rate Limiting (optional: memory limiter fallback used if unset)
REDIS_URL="redis://127.0.0.1:6379/0"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# Authentication & Security (generate a 32+ byte random string)
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS Configuration (comma-separated origins)
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"

# AI Provider Configuration (Groq — primary LLM provider)
# Set GROQ_API_KEY to enable real AI features (content generation, translation, sentiment, quality).
# If unset, MockAIProvider is used (offline/deterministic mode).
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# AI Provider Selection: "auto" (Groq→Gemini→Mock), "groq", "gemini", "mock"
AI_PROVIDER="auto"

# Gemini (legacy — optional, only used as fallback when GROQ_API_KEY is absent)
GEMINI_API_KEY=""
AI_MODEL_NAME="gemini-2.5-flash"

# Shared AI reliability settings
AI_REQUEST_TIMEOUT_SECONDS=30.0
AI_MAX_RETRIES=2
AI_INITIAL_BACKOFF_SECONDS=1.0
AI_MAX_BACKOFF_SECONDS=8.0
AI_OVERALL_DEADLINE_SECONDS=30.0

# Channel Constraints & Policy Thresholds
SMS_HARD_LIMIT_CHARS=1600
SMS_MAX_RECOMMENDED_SEGMENTS=3
VOICE_MAX_RECOMMENDED_SECONDS=90
WHATSAPP_FREEFORM_HARD_LIMIT_CHARS=4096
WHATSAPP_RECOMMENDED_LIMIT_CHARS=1024
WHATSAPP_TEMPLATE_LIMIT_CHARS=1024
EMAIL_SUBJECT_RECOMMENDED_LIMIT_CHARS=78
EMAIL_BODY_RECOMMENDED_WORDS=800

