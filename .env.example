# MassCommAI Environment Configuration
# Authoritative backend environment variables reside in backend/.env
# Authoritative frontend environment variables reside in frontend/.env

# Backend PostgreSQL Connection
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/masscommai_dev"
REDIS_URL="redis://localhost:6379/0"
SECRET_KEY="replace-with-a-secure-random-secret-key-at-least-32-chars-long"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
APP_ENV="development"
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_AI_PER_MINUTE=20

# Frontend API URL
VITE_API_BASE_URL="http://127.0.0.1:8000"

