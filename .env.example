# MassCommAI Environment Configuration
# Authoritative backend environment variables reside in backend/.env
# Authoritative frontend environment variables reside in frontend/.env

# Backend PostgreSQL Connection
DATABASE_URL="postgresql+psycopg://postgres:postgres@localhost:5432/masscommai_dev"
SECRET_KEY="replace-with-a-secure-random-secret-key"
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS="http://127.0.0.1:5173,http://localhost:5173"
APP_ENV="development"

# Frontend API URL
VITE_API_BASE_URL="http://127.0.0.1:8000"
